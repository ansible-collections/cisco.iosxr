---
extends: default

ignore: |
  .tox
  changelogs/*

rules:
  braces:
    max-spaces-inside: 1
    level: error
  brackets:
    max-spaces-inside: 1
    level: error
  line-length: disable
  # ansible-lint production profile requires these (otherwise it warns and
  # cannot apply yaml fix mode).
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  document-start: disable
